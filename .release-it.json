{
  "$schema": "https://unpkg.com/release-it/schema/release-it.json",
  "git": {
    "commitMessage": "chore(release): Release ${version}"
  },
  "github": {
    "release": true
  },
  "npm": {
    "skipChecks": true
  },
  "plugins": {
    "@release-it/keep-a-changelog": {
      "addUnreleased": true,
      "addVersionUrl": true
    }
  },
  "hooks": {
    "after:bump": [
      "prettier --check .",
      "npm run lint --max-warnings=0",
      "npm test",
      "npm run build",
      "npm audit --audit-level=low"
    ]
  }
}
